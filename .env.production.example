# Шаблон настроек backend для production.
# scripts/init-production-env.py создаёт backend/.env.production со случайными секретами.

# Размещение сайта и Docker Compose
# SITE_HOST — IP или имя сайта без протокола и порта; согласовать с frontend.
# HTTP_PORT/HTTPS_PORT — внешние порты nginx; сеть и адреса контейнеров назначает Docker.
SITE_HOST=bks-lab.ru
HTTP_PORT=80
HTTPS_PORT=443

# Приложение и логирование
# Имя приложения, режим отладки, параметры API и подробность логов.
APP_DEBUG=false

# PostgreSQL
# Подключение API и scheduler к базе: адрес, порт, база, пользователь и пароль.
# В Docker: db:5432. При запуске Python с хоста: localhost:5434.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=bkslab
POSTGRES_USER=bkslab
POSTGRES_PASSWORD=

# Статистика посещений
# STATS_SECRET используется для обезличивания посетителей; хранится только на сервере.
# Остальные параметры ограничивают частоту записи просмотров и длину входных полей.
STATS_SECRET=

# Администратор и сессии
# Логин и пароль единственного администратора; пустые значения отключают вход.
# ADMIN_ALLOWED_ORIGINS — JSON-массив разрешённых адресов со схемой, без завершающего слеша.
# Доступ по IP сохранён на время перехода на домен; после перехода его можно убрать.
# ADMIN_COOKIE_SECURE=false при работе по HTTP; после подключения HTTPS установить true.
# Срок сессии и интервал её очистки задаются в секундах.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_ALLOWED_ORIGINS=["http://bks-lab.ru","http://91.218.114.82"]
ADMIN_COOKIE_SECURE=false

# Обновление страниц после публикации
# Backend вызывает frontend по внутреннему URL, чтобы обновить кэш страниц после сохранения контента.
# REVALIDATE_SECRET должен совпадать у backend и frontend; это серверный секрет.
FRONTEND_INTERNAL_URL=http://frontend:3000
REVALIDATE_SECRET=

# News Analyzer: включение и расписание
# Работа редакционного центра и отдельного scheduler, часовой пояс и время обходов.
# Расписание и редакционные параметры служат значениями по умолчанию; настройки админки имеют приоритет.
NEWS_ENABLED=true
NEWS_TIMEZONE=Europe/Samara
NEWS_SCHEDULE=["08:00","14:00","20:00"]

# News Analyzer: загрузка источников
# Параллельность и таймауты загрузок RSS/HTML, лимиты размера ответа, редиректов и повторов.
# Размер ответа задаётся в байтах, таймауты и интервал запросов — в секундах.
NEWS_HTTP_CONCURRENCY=5
NEWS_HTTP_TIMEOUT_SECONDS=20
NEWS_HTTP_MAX_RESPONSE_BYTES=2097152
NEWS_HTTP_MAX_REDIRECTS=5
NEWS_HTTP_RETRIES=2
NEWS_SOURCE_MIN_INTERVAL_SECONDS=1

# News Analyzer: анализ через LLM
# Провайдер, модель, URL и ключ API для классификации собранных материалов.
# Без модели, URL или ключа материалы сохраняются и ожидают анализа.
# Параллельность, таймаут в секундах, лимит токенов ответа и повторы вызова модели.
NEWS_LLM_PROVIDER=polza
NEWS_LLM_MODEL=
NEWS_LLM_API_URL=
NEWS_LLM_API_KEY=
NEWS_LLM_CONCURRENCY=1
NEWS_LLM_TIMEOUT_SECONDS=60
NEWS_LLM_MAX_TOKENS=1800
NEWS_LLM_RETRIES=2

# News Analyzer: объём сбора и обработки
# Глубина первого сбора в днях, число материалов на источник, длина фрагмента в символах и размер пачки анализа.
NEWS_INITIAL_LOOKBACK_DAYS=30
NEWS_MAX_ITEMS_PER_SOURCE=50
NEWS_MAX_EXCERPT_CHARS=3000
NEWS_ANALYSIS_BATCH_SIZE=20

# News Analyzer: хранение данных
# Сроки хранения собранного текста и истории обработок, в днях.
NEWS_TEXT_RETENTION_DAYS=90
NEWS_HISTORY_RETENTION_DAYS=180

# News Analyzer: очередь и фоновый процесс
# Опрос очереди PostgreSQL, срок владения заданием, heartbeat и восстановление после ошибок.
# Число попыток задания, обновление настроек, обслуживание данных и время на завершение процесса.
# Все интервалы и таймауты в этой группе — в секундах.
NEWS_QUEUE_POLL_SECONDS=5
NEWS_LEASE_SECONDS=120
NEWS_HEARTBEAT_SECONDS=20
NEWS_JOB_MAX_ATTEMPTS=3
NEWS_JOB_RETRY_DELAY_SECONDS=60
NEWS_SETTINGS_REFRESH_SECONDS=30
NEWS_MAINTENANCE_INTERVAL_SECONDS=3600
NEWS_SHUTDOWN_GRACE_SECONDS=30

# News Analyzer: проверка работоспособности
# Scheduler обновляет служебный файл; healthcheck проверяет его возраст в секундах.
NEWS_HEALTH_FILE=/tmp/news-analyzer-health
NEWS_HEALTH_MAX_AGE_SECONDS=120

# Публичные параметры фронтенда
# Параметры рекламных блоков; согласовать с frontend/.env.production.
# Сборка и запуск frontend читают его собственный env-файл; backend эти параметры не использует.
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_YANDEX_AD_SIDEBAR_ID=
NEXT_PUBLIC_YANDEX_AD_ARTICLE_ID=
NEXT_PUBLIC_YANDEX_AD_INLINE_ID=
NEXT_PUBLIC_YANDEX_AD_NOTES_ID=
