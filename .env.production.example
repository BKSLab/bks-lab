# Copy via scripts/init-production-env.py; keep the resulting file private.
# Public hostname only, no scheme/path/port. DNS must point to the server.
SITE_HOST=bks-lab.ru
CONTACT_EMAIL=
HTTP_PORT=80
HTTPS_PORT=443

POSTGRES_USER=bkslab
POSTGRES_DB=bkslab
POSTGRES_PASSWORD=
STATS_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
REVALIDATE_SECRET=

# Configure a real mail account before enabling feedback on the live site.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_RECIPIENT=
SMTP_USE_TLS=false
SMTP_START_TLS=true

# News Analyzer: this private env is passed to the API and separate scheduler.
# Editorial settings edited in the admin UI override their defaults below.
NEWS_ENABLED=true
NEWS_TIMEZONE=Europe/Samara
NEWS_SCHEDULE=["08:00","14:00","20:00"]
# Use a provider-supported inexpensive Qwen model; keep the key private.
# Without all three values, collection continues with pending_analysis items.
NEWS_LLM_PROVIDER=polza
NEWS_LLM_MODEL=
NEWS_LLM_API_URL=
NEWS_LLM_API_KEY=
NEWS_LLM_CONCURRENCY=1
NEWS_LLM_TIMEOUT_SECONDS=60
NEWS_LLM_MAX_TOKENS=1800
NEWS_LLM_RETRIES=2
NEWS_HTTP_CONCURRENCY=5
NEWS_HTTP_TIMEOUT_SECONDS=20
NEWS_HTTP_MAX_RESPONSE_BYTES=2097152
NEWS_HTTP_MAX_REDIRECTS=5
NEWS_HTTP_RETRIES=2
NEWS_SOURCE_MIN_INTERVAL_SECONDS=1
NEWS_INITIAL_LOOKBACK_DAYS=30
NEWS_MAX_ITEMS_PER_SOURCE=50
NEWS_MAX_EXCERPT_CHARS=3000
NEWS_ANALYSIS_BATCH_SIZE=20
NEWS_TEXT_RETENTION_DAYS=90
NEWS_HISTORY_RETENTION_DAYS=180
NEWS_QUEUE_POLL_SECONDS=5
NEWS_LEASE_SECONDS=120
NEWS_HEARTBEAT_SECONDS=20
NEWS_JOB_MAX_ATTEMPTS=3
NEWS_JOB_RETRY_DELAY_SECONDS=60
NEWS_SETTINGS_REFRESH_SECONDS=30
NEWS_MAINTENANCE_INTERVAL_SECONDS=3600
NEWS_SHUTDOWN_GRACE_SECONDS=30
NEWS_HEALTH_FILE=/tmp/news-analyzer-health
NEWS_HEALTH_MAX_AGE_SECONDS=120

# Change both values together if this subnet conflicts with the server network.
BKS_NETWORK_SUBNET=172.30.55.0/24
BKS_PROXY_IP=172.30.55.10

# These public values are built into the frontend image.
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_YANDEX_AD_SIDEBAR_ID=
NEXT_PUBLIC_YANDEX_AD_ARTICLE_ID=
NEXT_PUBLIC_YANDEX_AD_NOTES_ID=
