# Application
APP_NAME=BKS Lab
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
# JSON array of the actual reverse proxy IPs/CIDRs; empty means trust none.
# Example for an explicitly configured local proxy: ["127.0.0.1", "::1"]
APP_TRUSTED_PROXIES=[]

# PostgreSQL
POSTGRES_USER=bkslab
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bkslab
# In Docker (compose env_file): db:5432. For a local backend run: localhost:5434.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Content
CONTENT_DIR=content
CONTENT_SYNC_TTL_SECONDS=5

# Stats (visitor hashing master secret; daily salt is derived from it)
STATS_SECRET=change-me
STATS_PAGEVIEW_RATE_LIMIT=60/minute

# Administrator: leave credentials empty to disable login (fail closed).
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Exact scheme + host + optional port, without slash. No Host-header inference.
# Local example: ["http://127.0.0.1:3000"]
ADMIN_ALLOWED_ORIGINS=[]
ADMIN_COOKIE_SECURE=true
# Set false only for a local HTTP development server.
ADMIN_SESSION_TTL_SECONDS=43200
ADMIN_CLEANUP_INTERVAL_SECONDS=3600

# SMTP: feedback returns 503 until host, sender and recipient are configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_RECIPIENT=
SMTP_USE_TLS=false
SMTP_START_TLS=true
# For implicit TLS (usually port 465): USE_TLS=true and START_TLS=false.
# Disable both only for a trusted local test server.
SMTP_TIMEOUT=10

# News Analyzer: a separate scheduler process, never a FastAPI background task.
# Policy/schedule values are defaults until changed in the admin UI.
NEWS_ENABLED=true
NEWS_TIMEZONE=Europe/Samara
NEWS_SCHEDULE=["08:00","14:00","20:00"]
# Configure one inexpensive provider-supported Qwen model. Empty key/model/URL
# leaves collected materials pending_analysis; there is no cost-accounting module.
NEWS_LLM_PROVIDER=polza
NEWS_LLM_MODEL=
NEWS_LLM_API_URL=
NEWS_LLM_API_KEY=
NEWS_LLM_CONCURRENCY=1
NEWS_LLM_TIMEOUT_SECONDS=60
NEWS_LLM_MAX_TOKENS=1800
NEWS_LLM_RETRIES=2
NEWS_HTTP_CONCURRENCY=5
NEWS_HTTP_TIMEOUT_SECONDS=20
NEWS_HTTP_MAX_RESPONSE_BYTES=2097152
NEWS_HTTP_MAX_REDIRECTS=5
NEWS_HTTP_RETRIES=2
NEWS_SOURCE_MIN_INTERVAL_SECONDS=1
NEWS_INITIAL_LOOKBACK_DAYS=30
NEWS_MAX_ITEMS_PER_SOURCE=50
NEWS_MAX_EXCERPT_CHARS=3000
NEWS_ANALYSIS_BATCH_SIZE=20
NEWS_TEXT_RETENTION_DAYS=90
NEWS_HISTORY_RETENTION_DAYS=180
NEWS_QUEUE_POLL_SECONDS=5
NEWS_LEASE_SECONDS=120
NEWS_HEARTBEAT_SECONDS=20
NEWS_JOB_MAX_ATTEMPTS=3
NEWS_JOB_RETRY_DELAY_SECONDS=60
NEWS_SETTINGS_REFRESH_SECONDS=30
NEWS_MAINTENANCE_INTERVAL_SECONDS=3600
NEWS_SHUTDOWN_GRACE_SECONDS=30
NEWS_HEALTH_FILE=/tmp/news-analyzer-health
NEWS_HEALTH_MAX_AGE_SECONDS=120
