# Server-side base URL of the backend API (used by src/lib/api, stage 2).
# Local default; Docker Compose supplies http://backend:8000 at runtime.
API_INTERNAL_URL=http://127.0.0.1:8000

# Public origin of the site, used for metadataBase (canonical/OG URLs).
SITE_URL=http://localhost:3000

# Operator webhook; generate at least 32 random characters. Never NEXT_PUBLIC_.
REVALIDATE_SECRET=
# Build-time dev proxy destination; production requests go through nginx.
API_PROXY_URL=http://127.0.0.1:8000

# Public contact address shown on /contacts and /privacy (set before building).
# Leave empty until the owner provides the actual address.
CONTACT_EMAIL=

# Advertising is disabled by default, including local development.
# Enable only after site moderation and configure real IDs from Yandex.
# NEXT_PUBLIC_* values are embedded at build time; changing them needs a rebuild.
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_YANDEX_AD_SIDEBAR_ID=
NEXT_PUBLIC_YANDEX_AD_ARTICLE_ID=
NEXT_PUBLIC_YANDEX_AD_NOTES_ID=
