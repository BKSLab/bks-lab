# Public build settings and frontend runtime settings.
# Set the same IP/hostname and revalidation secret as in backend/.env.production.
SITE_HOST=bks-lab.ru
SITE_URL=http://bks-lab.ru
NGINX_ENVSUBST_FILTER=^SITE_HOST$
API_INTERNAL_URL=http://backend:8000
API_PROXY_URL=http://backend:8000
REVALIDATE_SECRET=

NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_YANDEX_AD_SIDEBAR_ID=
NEXT_PUBLIC_YANDEX_AD_ARTICLE_ID=
NEXT_PUBLIC_YANDEX_AD_INLINE_ID=
NEXT_PUBLIC_YANDEX_AD_NOTES_ID=
