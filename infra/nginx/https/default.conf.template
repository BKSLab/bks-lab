include /etc/nginx/snippets/http.conf;
server {
    listen 80;
    server_name ${SITE_HOST};
    access_log /dev/stdout site;
    location = /nginx-health { access_log off; return 200 "ok\n"; }
    location ^~ /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://${SITE_HOST}$request_uri; }
}
server {
    listen 443 ssl;
    http2 on;
    server_name ${SITE_HOST};
    access_log /dev/stdout site;
    ssl_certificate /etc/letsencrypt/live/${SITE_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SITE_HOST}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    include /etc/nginx/snippets/security.conf;
    add_header Strict-Transport-Security "max-age=31536000" always;
    include /etc/nginx/snippets/routes.conf;
}
